# ===========================
# BTG V3 - Backend API (.env)
# ===========================
# !! NEVER commit this file to Git !!

# --- Database ---
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/btg-v3?retryWrites=true&w=majority

# --- Security & Auth ---
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
RATE_LIMIT_MAX=100
MAX_LOGIN_ATTEMPTS=5

# --- Business Logic ---
ADMIN_WHATSAPP_NUMBER=88017XXXXXXXX
IMG_COMPRESSION_QUALITY=80
LOG_RETENTION_DAYS=90

# --- External Services ---
IMGBB_API_KEY=your_imgbb_api_key_here

# --- Server ---
PORT=5000
NODE_ENV=development

# --- CORS ---
FRONTEND_URL=http://localhost:5173
